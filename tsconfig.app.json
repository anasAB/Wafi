{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],

    /* Path alias — mirrors vite.config.ts `resolve.alias` so vue-tsc can resolve
       `@/...` imports during type-checking, not just Vite at bundle time.
       (TS 5+ resolves `paths` relative to this file; no `baseUrl` needed.) */
    "paths": { "@/*": ["./src/*"] },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  // Tests are type-checked separately (tsconfig.vitest.json / `npm run type-check:test`)
  // and run by vitest — they must NOT be part of the production build, so a test-only
  // type error can never break `npm run build` (and therefore the Vercel deploy).
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
