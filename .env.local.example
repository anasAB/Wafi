# Copy to .env.local and fill in values from your Supabase + PowerSync dashboards.
# NEVER commit .env.local to git.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PowerSync instance URL. Required for the device to sync to the cloud; leave
# blank to run offline-only against local SQLite (the app still signs in).
VITE_POWERSYNC_URL=

# Sentry DSN for error tracking (WAFI-023). Leave blank to disable --
# initSentry() no-ops without it. Get one free at sentry.io.
VITE_SENTRY_DSN=

# Environment tag sent with every Sentry event, so a staging/preview build
# that accidentally ships a production DSN doesn't commingle with real
# production data in the Sentry dashboard. Defaults to "production" if unset
# (only takes effect when VITE_SENTRY_DSN is set and this is a PROD build).
VITE_SENTRY_ENVIRONMENT=production

# WhatsApp number (international digits, no +) the "report a problem"
# screen and ForgotPasswordPage.vue send support messages to. This is the
# FOUNDERS' own support number, not a shop's customer phone.
VITE_SUPPORT_WHATSAPP_PHONE=

# Epic 1 stub identity — replaced by real auth in a later epic
VITE_STUB_SHOP_ID=00000000-0000-0000-0000-000000000001
VITE_STUB_DEVICE_ID=00000000-0000-0000-0000-000000000002
VITE_STUB_DEVICE_CODE=A
